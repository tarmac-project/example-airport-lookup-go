{
  "scenarios": {
    "cache_hits": {
      "executor": "constant-arrival-rate",
      "rate": 50,
      "timeUnit": "1s",
      "duration": "3m",
      "preAllocatedVUs": 20,
      "maxVUs": 100
    }
  },
  "thresholds": {
    "http_req_failed": ["rate<0.005"],
    "checks": ["rate>0.995"],
    "http_req_duration": ["p(95)<200", "p(99)<500"],
    "dropped_iterations": ["count==0"]
  },
  "noConnectionReuse": false,
  "userAgent": "airport-lookup-ci/1.0"
}
